// main-pc's waybar config, linked as ~/.config/waybar/config.jsonc. The module
// definitions are shared (../../waybar/common.jsonc); this file only says
// where the bar goes and what is on its right-hand side.
{
  "include": ["~/.config/waybar/common.jsonc"],

  // Bar only on the small 1080p screen (below the ultrawide). Without this,
  // waybar spawns one bar per output. Matched by description, not DP-n
  // (see hyprland.conf).
  "output": "Dell Inc. DELL P2426H FHVRYD4",

  "modules-right": [
    "tray",
    "pulseaudio",
    "cpu",
    "memory",
    "network",
    "bluetooth",
    "custom/power"
  ]
}
